# ===== FinanceHot 环境变量样例（不含真实密钥） =====

# PostgreSQL（pgvector 镜像）
DATABASE_URL=postgresql://financehot:financehot@localhost:5433/financehot

# Redis
REDIS_URL=redis://localhost:6379

# 应用地址
APP_URL=http://localhost:3000

# LLM Provider（留空表示未配置，系统仍可启动）
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Embedding Provider
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Admin 初始账户（后台阶段使用）
ADMIN_EMAIL=
ADMIN_PASSWORD=
