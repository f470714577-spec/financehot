# ===== FinanceHot 环境变量样例（不含真实密钥） =====

# PostgreSQL（pgvector 镜像）
DATABASE_URL=postgresql://financehot:financehot@localhost:5433/financehot

# Redis
REDIS_URL=redis://localhost:6379

# 阶段07 Worker/BullMQ（队列前缀、并发、重试和指数退避集中配置）
FINANCEHOT_QUEUE_PREFIX=financehot:stage07
FINANCEHOT_WORKER_CONCURRENCY=2
FINANCEHOT_QUEUE_ATTEMPTS=3
FINANCEHOT_QUEUE_BACKOFF_MS=1000
FINANCEHOT_KEEP_COMPLETED=100
FINANCEHOT_KEEP_FAILED=100
FINANCEHOT_SCHEDULER_INTERVAL_MS=30000

# 应用地址
APP_URL=http://localhost:3000

# LLM Provider（留空表示未配置，系统仍可启动）
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_MS=250
# 未知价格留空；只在有供应商公开单价时填写
LLM_INPUT_COST_PER_1K=
LLM_OUTPUT_COST_PER_1K=

# Embedding Provider
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Admin 初始账户（后台阶段使用）
ADMIN_EMAIL=
ADMIN_PASSWORD=
