{
  "name": "@financehot/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "crawl-once": "tsx src/crawl-once-cli.ts",
    "install-sources": "tsx src/install-sources-cli.ts",
    "ping:redis": "tsx src/ping-redis.ts"
  },
  "dependencies": {
    "@financehot/ai": "workspace:*",
    "@financehot/crawler": "workspace:*",
    "@financehot/db": "workspace:*",
    "@financehot/shared": "workspace:*",
    "bullmq": "^5.81.3",
    "drizzle-orm": "^0.38.2",
    "ioredis": "^5.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
